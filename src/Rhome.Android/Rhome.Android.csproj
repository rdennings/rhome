<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Android head (PLAN.md §4): Android file access and the app's start-up. Needs the `android` workload,
       so it's left out of Rhome.Portable.slnf, which the Linux CI job builds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>io.github.rdennings.rhome</ApplicationId>
    <ApplicationTitle>rhome</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- The Thor (and nearly every current handheld) is arm64; one ABI keeps the APK small. -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>
  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rhome.App/Rhome.App.csproj" />
  </ItemGroup>
</Project>
