<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Android head (PLAN.md §4): Android file access and the app's start-up. Needs the `android` workload,
       so it's left out of Rhome.Portable.slnf, which the Linux CI job builds. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>io.github.rdennings.rhome</ApplicationId>
    <ApplicationTitle>rhome</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- The Thor (and nearly every current handheld) is arm64; one ABI keeps the APK small. -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>
  <!-- Release signing (#84). With the RHOME_KEYSTORE environment variable (or property) set to the release keystore,
       the APK is signed with rhome's release key, so it installs over a GitHub release and the bank survives. The
       password is read from the RHOME_KEYSTORE_PASSWORD environment variable, never from the command line, so it
       stays out of logs. Without RHOME_KEYSTORE the build is signed with this machine's debug key, as before. -->
  <PropertyGroup Condition="'$(RHOME_KEYSTORE)' != ''">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>$(RHOME_KEYSTORE)</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>rhome</AndroidSigningKeyAlias>
    <AndroidSigningStorePass>env:RHOME_KEYSTORE_PASSWORD</AndroidSigningStorePass>
    <AndroidSigningKeyPass>env:RHOME_KEYSTORE_PASSWORD</AndroidSigningKeyPass>
  </PropertyGroup>
  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Rhome.App/Rhome.App.csproj" />
  </ItemGroup>
</Project>
