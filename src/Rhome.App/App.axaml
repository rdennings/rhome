<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Rhome.App.App"
             RequestedThemeVariant="Dark">
    <!-- The "Workbench" theme (issue #49, mockup A): near-black for the Thor's AMOLED screens, dark cards, one teal
         accent. Fluent draws the controls; these resources recolour it, and the classes below are the app's own pieces. -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- The palette -->
            <Color x:Key="RhomeAccentColor">#2FD3B0</Color>
            <SolidColorBrush x:Key="RhomeBackground" Color="#0A0B0D" />
            <SolidColorBrush x:Key="RhomeCard" Color="#131518" />
            <SolidColorBrush x:Key="RhomeCardBorder" Color="#23262B" />
            <SolidColorBrush x:Key="RhomeSlot" Color="#1A1D21" />
            <SolidColorBrush x:Key="RhomeControlBorder" Color="#2A2E34" />
            <SolidColorBrush x:Key="RhomeText" Color="#E8EAED" />
            <SolidColorBrush x:Key="RhomeMuted" Color="#9AA0A8" />
            <SolidColorBrush x:Key="RhomeAccent" Color="#2FD3B0" />
            <SolidColorBrush x:Key="RhomeOnAccent" Color="#04201A" />
            <SolidColorBrush x:Key="RhomeAccentSoft" Color="#0E2823" />
            <SolidColorBrush x:Key="RhomeAmber" Color="#E0B33A" />
            <SolidColorBrush x:Key="RhomeDashed" Color="#59606A" />
            <SolidColorBrush x:Key="RhomeScrim" Color="#000000" Opacity="0.6" />

            <!-- Fluent, recoloured -->
            <Color x:Key="SystemAccentColor">#2FD3B0</Color>
            <Color x:Key="SystemAccentColorDark1">#26B999</Color>
            <Color x:Key="SystemAccentColorDark2">#1E9C81</Color>
            <Color x:Key="SystemAccentColorDark3">#167F69</Color>
            <Color x:Key="SystemAccentColorLight1">#59DDC0</Color>
            <Color x:Key="SystemAccentColorLight2">#7DE8D1</Color>
            <Color x:Key="SystemAccentColorLight3">#A6F0E0</Color>
            <SolidColorBrush x:Key="SystemRegionBrush" Color="#131518" />
            <CornerRadius x:Key="ControlCornerRadius">10</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">14</CornerRadius>

            <SolidColorBrush x:Key="ButtonBackground" Color="#131518" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1A1D21" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#0E0F12" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#0F1113" />
            <SolidColorBrush x:Key="ButtonForeground" Color="#E8EAED" />
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E8EAED" />
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E8EAED" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5C6168" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2A2E34" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#3A3F46" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#2FD3B0" />
            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#1F2226" />
            <Thickness x:Key="ButtonBorderThemeThickness">1</Thickness>

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#2FD3B0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#59DDC0" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#26B999" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#163A33" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#04201A" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#04201A" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#04201A" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#5C7F77" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="Transparent" />

            <SolidColorBrush x:Key="TextControlBackground" Color="#1A1D21" />
            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1A1D21" />
            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1A1D21" />
            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2A2E34" />
            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#3A3F46" />
            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#2FD3B0" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- A button with only an icon in it (Undo, the box arrows) -->
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon.bare">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Path.icon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
        </Style>

        <!-- A panel of the screen: the game, the bank, the selected Pokémon, the pending list -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource RhomeCard}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RhomeCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <!-- A small capitalised heading at the top of a card, e.g. "EMERALD · PARTY" -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.9" />
            <Setter Property="Foreground" Value="{DynamicResource RhomeMuted}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource RhomeMuted}" />
        </Style>
        <Style Selector="TextBlock.problem">
            <Setter Property="Foreground" Value="{DynamicResource RhomeAmber}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- "3 pending" -->
        <Style Selector="Border.pill">
            <Setter Property="Background" Value="{DynamicResource RhomeAccentSoft}" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,5" />
        </Style>
        <Style Selector="Border.pill > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RhomeAccent}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- A move, in the selected Pokémon's card -->
        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource RhomeSlot}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,5" />
        </Style>

        <!-- A box slot. "picked": the Pokémon picked up. The dashed states draw their own outline (SlotFace). -->
        <Style Selector="Button.slot">
            <Setter Property="Background" Value="{DynamicResource RhomeSlot}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RhomeCardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2.5" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.slot.picked">
            <Setter Property="Background" Value="{DynamicResource RhomeAccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RhomeAccent}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.slot.dashed">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.slot.hollow">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
