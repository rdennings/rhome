<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Rhome.App.Views.TransferView">
    <!-- The split view (#45): a game's party and boxes on the left, the bank on the right. Every move is pending until Save. -->
    <!-- The pending-changes sheet (#46) goes on top, from code. -->
    <Panel x:Name="Root">
        <Grid Margin="16" ColumnDefinitions="*,16,*,16,0.8*" RowDefinitions="Auto,Auto,*">
            <DockPanel Grid.ColumnSpan="5" Margin="0,0,0,4">
                <Button x:Name="BackButton" DockPanel.Dock="Left" Content="‹ My saves" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CopiesText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="ProblemText" Grid.Row="1" Grid.ColumnSpan="5" Foreground="DarkOrange" TextWrapping="Wrap"
                       IsVisible="False" Margin="0,4,0,4" />

            <!-- The game -->
            <DockPanel Grid.Row="2" Grid.Column="0">
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,8,0,8">
                    <TextBlock Text="Party" FontSize="15" FontWeight="SemiBold" />
                    <UniformGrid x:Name="PartyGrid" Columns="6" Rows="1" Height="64" />
                </StackPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button x:Name="SavePrev" DockPanel.Dock="Left" Content="‹" />
                    <Button x:Name="SaveNext" DockPanel.Dock="Right" Content="›" />
                    <TextBlock x:Name="SaveBoxTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DockPanel>
                <UniformGrid x:Name="SaveGrid" Columns="6" Rows="5" />
            </DockPanel>

            <!-- The bank -->
            <DockPanel Grid.Row="2" Grid.Column="2">
                <TextBlock x:Name="HintText" DockPanel.Dock="Top" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,8,0,8" MinHeight="64" />
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                    <Button x:Name="BankPrev" DockPanel.Dock="Left" Content="‹" />
                    <Button x:Name="BankNext" DockPanel.Dock="Right" Content="›" />
                    <TextBlock x:Name="BankBoxTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </DockPanel>
                <UniformGrid x:Name="BankGrid" Columns="6" Rows="5" />
            </DockPanel>

            <!-- Pending changes -->
            <DockPanel Grid.Row="2" Grid.Column="4">
                <TextBlock DockPanel.Dock="Top" Text="Pending changes" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,8" />
                <StackPanel x:Name="ChoicePanel" DockPanel.Dock="Top" Spacing="6" IsVisible="False" Margin="0,0,0,12" />
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button x:Name="SaveButton" Content="Review and save" Classes="accent" Margin="0,0,8,8" />
                    <Button x:Name="UndoButton" Content="Undo last" Margin="0,0,8,8" />
                    <Button x:Name="DiscardButton" Content="Discard all" Margin="0,0,8,8" />
                </WrapPanel>
                <ScrollViewer>
                    <TextBlock x:Name="PendingText" TextWrapping="Wrap" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Panel>
</UserControl>
