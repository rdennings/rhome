<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Rhome.App.Views"
             x:Class="Rhome.App.Views.SavesView">
    <!-- My saves (#43): the saves the last scan found, checked on every launch. One tap opens a save. -->
    <!-- About (#48: sprite credits and download) goes on top, from code. -->
    <Panel x:Name="Root">
        <Grid x:Name="Columns" Margin="12" ColumnDefinitions="3*,10,2*" RowDefinitions="Auto,*">
            <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BankButton" Content="Bank" Classes="accent" />
                    <Button x:Name="ScanButton" Content="Scan now" />
                    <Button x:Name="SetupButton" Content="Set up again" />
                    <Button x:Name="AboutButton" Content="About" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SavesHeader" Text="My saves" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Grid.Column="0">
                <TextBlock x:Name="Notices" DockPanel.Dock="Top" Classes="problem" IsVisible="False" Margin="0,0,0,8" />
                <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" TextWrapping="Wrap" IsVisible="False"
                           Text="No Pokémon saves found. Play a little and save in game, then tap Scan now. If a folder is missing, tap Set up again." />
                <Border Classes="card" Padding="6">
                    <ListBox x:Name="SavesList" Background="Transparent" />
                </Border>
            </DockPanel>

            <!-- On a two-screen device the log goes to the bottom screen (#49) -->
            <Border x:Name="LogCard" Grid.Row="1" Grid.Column="2" Classes="card" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="label" Text="LOG" Margin="0,0,0,8" />
                    <views:LogView />
                </DockPanel>
            </Border>
        </Grid>
    </Panel>
</UserControl>
