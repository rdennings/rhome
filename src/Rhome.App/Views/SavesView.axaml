<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Rhome.App.Views"
             x:Class="Rhome.App.Views.SavesView">
    <!-- The saves found by the last scan, until the real My saves list (#43) and the transfer screens (#45, #46).
         Keeps the test writes from #40 for checking save access on a device. -->
    <Grid Margin="16" ColumnDefinitions="3*,16,2*" RowDefinitions="Auto,*">
        <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button x:Name="ScanButton" Content="Scan now" />
                <Button x:Name="SetupButton" Content="Set up again" />
            </StackPanel>
            <TextBlock x:Name="SavesHeader" Text="Saves" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
                <TextBlock x:Name="SelectedText" TextWrapping="Wrap" Text="Tap a save to test writing it." Opacity="0.75" />
                <WrapPanel>
                    <Button x:Name="MoneyButton" Content="Write back with money +1" IsEnabled="False" Margin="0,0,8,8" />
                    <Button x:Name="SameButton" Content="Write back unchanged" IsEnabled="False" Margin="0,0,8,8" />
                </WrapPanel>
            </StackPanel>
            <TextBlock x:Name="FolderProblems" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="DarkOrange" IsVisible="False" Margin="0,0,0,8" />
            <ListBox x:Name="SavesList" />
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Log" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
            <views:LogView />
        </DockPanel>
    </Grid>
</UserControl>
